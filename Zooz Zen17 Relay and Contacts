/**
 * Zooz ZEN17 Universal Relay with two relay and two contact sensor children.
 * ZEN17 is a Z-Wave device. Relay outputs are child switches at endpoints 1
 * and 2. S1/S2 are contact sensor children; set parameters 2 and 3 to 7 for
 * open/close reporting. Device settings 1-27 are exposed below.
 */
import groovy.transform.Field

@Field static final String DRIVER_VERSION = "1.2.2"
@Field static final Map COMMAND_CLASS_VERSIONS = [
    0x20: 1, // Basic
    0x25: 1, // Switch Binary
    0x30: 2, // Sensor Binary
    0x60: 3, // Multi Channel
    0x70: 4, // Configuration
    0x71: 8  // Notification
]

